# Local development uses SQLite — this is what `prisma/schema.prisma`'s
# datasource is currently configured for (provider = "sqlite"). Leave this
# exactly as shown below for local dev.
#   DATABASE_URL="file:./dev.db"
#
# Production (Vercel) is planned to run on Postgres instead. When that
# migration happens, this becomes a real Postgres connection string, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# — and schema.prisma's datasource provider must be changed from "sqlite"
# to "postgresql" at the same time (they have to match). Not done yet; see
# PROGRESS.md for the current state of that migration.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (see src/lib/auth.ts). The app throws
# a clear error at request time if this is unset — there is no insecure
# fallback. Generate a real value for any real deployment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the value below (or any value committed anywhere) in
# production — treat it exactly like a password.
SESSION_SECRET="replace-with-a-random-secret-for-production"
