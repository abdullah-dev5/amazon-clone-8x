generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  createdAt     DateTime        @default(now())

  addresses     Address[]
  paymentMethods PaymentMethod[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist?
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders     Order[]

  @@index([userId])
}

model PaymentMethod {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardholderName String
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  imageUrl String?
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  brand       String?
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  images      String
  rating      Float            @default(0)
  reviewCount Int              @default(0)
  createdAt   DateTime         @default(now())

  variants    ProductVariant[]
  reviews     Review[]

  @@index([categoryId])
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  sku              String   @unique
  priceCents       Int
  compareAtCents   Int?
  stock            Int      @default(0)
  imageUrl         String?
  isDefault        Boolean  @default(false)

  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  // Seeded reviews have no real user (userId null) and are exempt from this —
  // SQL treats each NULL as distinct, so they never collide with each other
  // or with a real customer's review. Only blocks a signed-in user from
  // reviewing the same product twice; enforced again at the app layer for a
  // clean error before hitting the constraint (see POST /api/reviews).
  @@unique([productId, userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id     String         @id @default(cuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String         @id @default(cuid())
  wishlistId String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([wishlistId, variantId])
  @@index([variantId])
}

// A real, persisted fulfillment lifecycle: PLACED -> PROCESSING -> SHIPPED
// -> DELIVERED, with CANCELLED reachable from PLACED. There's no
// warehouse/carrier integration or background job driving this forward —
// see lib/order-status.ts's ADVANCE_TRANSITIONS for the small,
// ownership-gated, server-validated mechanism used to move an order
// through these states for demonstration/testing.
enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED
}

// Deliberately no redemption-count/per-user-usage tracking — not required
// by any stated requirement, and would be a table added merely because
// it's theoretically possible. Validity (active/expiry/minimum) is
// re-checked fresh against the live cart at every use, including inside
// the same transaction that creates the order — see lib/coupon.ts.
model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  value            Int
  minSubtotalCents Int?
  expiresAt        DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PLACED)

  // One per checkout session (see lib/checkout.ts) — lets place-order be
  // called twice (double-click, client retry after a dropped response)
  // without creating two orders. A unique-constraint violation on this
  // column means "already placed", not an error.
  idempotencyKey String      @unique

  // address snapshot at time of purchase (never live-joins a mutable Address row)
  addressId      String?
  address        Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shipToName     String
  shipToLine1    String
  shipToLine2    String?
  shipToCity     String
  shipToState    String
  shipToPostalCode String
  shipToCountry  String

  deliveryOption String

  // Coupon applied at purchase time, if any — a snapshot for order-history
  // legibility (so a past order's total is self-explanatory), not a live
  // reference back to the Coupon row (which could later change or be
  // deleted). Nullable/defaulted so existing orders remain valid as-is.
  couponCode     String?
  discountCents  Int         @default(0)

  subtotalCents  Int
  shippingCents  Int
  taxCents       Int
  totalCents     Int

  items          OrderItem[]
  placedAt       DateTime    @default(now())

  @@index([userId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // snapshot at time of purchase (never live-joins a mutable Product/Variant row)
  productTitle String
  variantName  String
  imageUrl     String?
  unitPriceCents Int
  quantity     Int

  @@index([orderId])
}
